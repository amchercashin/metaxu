{
  "$schema": "https://json-schema.org/draft/07/schema#",
  "title": "RiverDayEvent",
  "type": "object",
  "required": ["id", "title", "gesture", "biome_tags", "requires", "forbidden_if", "primary_bearer", "ribbonOrder", "setup", "choices"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "gesture": { "type": "string" },
    "biome_tags": { "type": "array", "items": { "type": "string" } },
    "region_tags": { "type": "array", "items": { "type": "string" } },
    "requires": { "type": "array", "items": { "type": "string" } },
    "forbidden_if": { "type": "array", "items": { "type": "string" } },
    "primary_bearer": { "type": "string" },
    "ribbonOrder": { "type": "number" },
    "setup": { "type": "array", "items": { "type": "string" } },
    "choices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "line"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "line": { "type": "string" },
          "speaker": { "type": "string" },
          "effects": { "type": "object" },
          "bodyCheck": { "type": "object" }
        }
      }
    }
  }
}
